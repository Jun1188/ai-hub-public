{
  "name": "ai-hub-public-lite",
  "productName": "AI Hub Lite",
  "version": "1.32.61-public.1",
  "description": "Public local-first desktop tools. Independent profile; external connections and automatic synchronization are off by default.",
  "main": "electron/public-startup.js",
  "author": "Jun1188",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js --all",
    "hub:stdio": "node src/mcp/stdio-entry.js",
    "hub:http": "node src/mcp/http-entry.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test:public": "node scripts/test-public-boundary.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "discord.js": "14.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jun1188.aihub.publiclite",
    "productName": "AI Hub Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "skills/**/*",
      "scripts/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "README.md",
      "THIRD-PARTY-NOTICES.md",
      "public-profile.json",
      "THIRD-PARTY-NPM.json",
      "THIRD-PARTY-LICENSES/**/*"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Hub Lite",
      "artifactName": "AI-Hub-Lite-Setup-${version}.${ext}",
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "node.exe",
          "LICENSE-node.txt",
          "runtime-manifest.json"
        ]
      },
      {
        "from": "resources/herdr",
        "to": "herdr"
      }
    ],
    "electronVersion": "45.2.3",
    "beforePack": "scripts/release-runtime-hooks.cjs",
    "afterPack": "scripts/release-runtime-hooks.cjs",
    "artifactName": "AI-Hub-Lite-Setup-${version}.${ext}"
  },
  "publicLite": true
}
