{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host-private local credential broker request",
  "type": "object",
  "additionalProperties": false,
  "required": ["credentialRef", "operationId", "jobId", "payload"],
  "properties": {
    "credentialRef": {"type": "string", "pattern": "^credential:(lmstudio|llamacpp|api-[a-z][a-z0-9-]{0,47})$"},
    "operationId": {"type": "string", "enum": ["lmstudio.models", "lmstudio.legacyModels", "lmstudio.catalog", "lmstudio.chat", "lmstudio.load", "lmstudio.unload", "llamacpp.models", "llamacpp.catalog", "llamacpp.chat", "llamacpp.load", "llamacpp.unload", "llamacpp.health", "llamacpp.props", "llamacpp.router", "api.request"]},
    "jobId": {"type": "string", "pattern": "^[-\\w:.]{1,160}$"},
    "payload": {"type": "object"}
  },
  "x-boundary": "Host-private module API only; no public decrypt, secret-return, arbitrary-origin, or caller-authentication-header interface. The payload is also operation-validated at runtime."
}
